# Environment variables read by evidence-mapper (spec 001, FR-5).
# Placeholder values only. Never commit real values.
# For local use: copy to .env (gitignored), fill in, then run
#   uv run --env-file .env evidence-mapper ...
# Empty values are treated as not set.

# Regulations.gov API key from api.data.gov. Secret. Required by `config check` and acquisition.
REGULATIONS_GOV_API_KEY=

# AWS named profile used for Bedrock in later specs. Optional for now.
AWS_PROFILE=

# Where spike data lives. Defaults to <repo>/data.
EVIDENCE_MAPPER_DATA_DIR=

# DEBUG, INFO, WARNING or ERROR. Defaults to INFO.
EVIDENCE_MAPPER_LOG_LEVEL=INFO
